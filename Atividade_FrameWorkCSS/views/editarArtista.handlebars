<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Artista</title>
</head>
<body>
    <h1>Editar Artista</h1>
    <form action="/artista/{{artista.id}}/editar" method="POST">

    <input type="hidden" name="_method" value="PUT">

    <label>Nome:</label>
    <input type="text" name="nome" value="{{artista.nome}}" required>

    <br>

    <label>Ano de nascimento:</label>
    <input type="number" name="anoNascimento" value="{{artista.anoNascimento}}" required>

    <br>

    <label>Nome artístico:</label>
    <input type="text" name="nomeArtistico" value="{{artista.nomeArtistico}}" required>

    <br>

    <button type="submit">Salvar alterações</button>

    </form>

</body>
</html>