<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diretores</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <h1>Diretores</h1>
    <a href="/diretor/cadastrar">Cadastrar novo diretor</a>
    <br>
    <a href="/">Home</a>

    <ul>
        {{#each diretores}}

        <li>
            <a href="/diretores/{{this.id}}">
                {{this.nome}}
            </a>

            <a href="/diretor/{{this.id}}/editar">
                Editar
            </a>

                       <form id="formExcluir{{this.id}}" action="/diretor/{{this.id}}/delete" method="POST" style="display:inline;">
                <input type="hidden" name="_method" value="DELETE">

                <button type="button" data-bs-toggle="modal" data-bs-target="#modalExcluir{{this.id}}">
                    Excluir
                </button>
            </form>

            <div class="modal fade" id="modalExcluir{{this.id}}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Confirmar exclusão</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                        </div>

                        <div class="modal-body">
                            Tem certeza que deseja excluir? <strong>{{this.nome}}</strong>?
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" form="formExcluir{{this.id}}" class="btn btn-danger">Excluir</button>
                        </div>

                    </div>
                </div>
            </div>
        </li>

        {{/each}}
    </ul>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>