<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Diretor</title>
</head>
<body>
    <h1>Editar Diretor</h1>
    <form action="/diretor/{{diretor.id}}/editar" method="POST">

    <input type="hidden" name="_method" value="PUT">

    <label>Nome:</label>
    <input type="text" name="nome"  value="{{diretor.nome}}" required>

    <br>

    <label>Ano de nascimento:</label>
    <input type="number" name="anoNascimento" value="{{diretor.anoNascimento}}" required>

    <br>

    <label>Nacionalidade:</label>
    <input type="text" name="nacionalidade" value="{{diretor.nacionalidade}}" required>

    <br>

    <button type="submit">Salvar alterações</button>

    </form>

</body>
</html>